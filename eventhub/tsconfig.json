{
  "compilerOptions": {
    "module": "commonjs",                  
    "moduleResolution": "node",             
    "target": "ES2020",                     
    "outDir": "./dist",                      
    "rootDir": "./src",  
    "types": ["jest", "node"],                   
    "strict": true,                         
    "esModuleInterop": true,               
    "emitDecoratorMetadata": true,           
    "experimentalDecorators": true,          
    "resolveJsonModule": true,               
    "skipLibCheck": true,                    
    "forceConsistentCasingInFileNames": true 
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
