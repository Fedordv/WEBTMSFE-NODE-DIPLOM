{
  "compilerOptions": {
    "module": "commonjs",                   // стабильный модуль для NestJS
    "moduleResolution": "node",             // классическое разрешение модулей
    "target": "ES2020",                     // современный JS для Node
    "outDir": "./dist",                      // куда компилируется
    "rootDir": "./src",                      // корневая папка исходников
    "strict": true,                          // включаем строгую проверку типов
    "esModuleInterop": true,                 // для работы с CommonJS пакетами
    "emitDecoratorMetadata": true,           // нужно для NestJS
    "experimentalDecorators": true,          // нужно для NestJS
    "resolveJsonModule": true,               // позволяет импортировать JSON файлы
    "skipLibCheck": true,                    // ускоряет сборку, игнорируя проверки типов библиотек
    "forceConsistentCasingInFileNames": true // строгое соответствие регистру файлов
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
